---
const { pathname } = Astro.props;
const isArticles = pathname.startsWith("/articles");
---

<div
  class='flex justify-center sticky top-2 items-center gap-[25px] w-full z-10'
>
  <div
    class='w-[70%] sm:w-[80%] border flex items-center sm:justify-center justify-end bg-gray-10/50 backdrop-blur-sm rounded-3xl py-2 px-4'
  >
    <div class='flex items-center sm:gap-8 gap-5'>
      <div class='flex items-center gap-4'>
        <ul
          id='mobile-menu'
          class='w-[90%] sm:w-full sm:flex-row flex-col sm:bg-transparent bg-base-200 backdrop-blur-sm sm:static fixed top-12 left-[5%] rounded-2xl sm:border-transparent border mx-auto items-center text-base sm:p-0 p-2 gap-2 sm:gap-4 hidden sm:flex'
        >
          <li><a href='/#about' class='hover:underline'>About</a></li>
          <li>
            <a href='/projects' target='_blank' class='hover:underline'
              >Projects</a
            >
          </li>
          <li><a href='/#experience' class='hover:underline'>Experience</a></li>
          <li><a href='/contact' class='hover:underline'>Contact</a></li>
        </ul>

        <a
          href='/articles'
          target='_blank'
          class='hover:underline hidden sm:block'>Articles</a
        >
        <a
          href={isArticles ? "/" : "/articles"}
          target={isArticles ? undefined : "_blank"}
          class='hover:underline block sm:hidden'
        >
          {isArticles ? "Home" : "Articles"}
        </a>
      </div>

      <div class='flex items-center gap-2'>
        <button
          id='hamburger-btn'
          class='flex sm:hidden cursor-pointer'
          aria-label='Menu'
          aria-controls='mobile-menu'
          aria-expanded='false'
        >
          <svg
            xmlns='http://www.w3.org/2000/svg'
            height='24px'
            viewBox='0 -960 960 960'
            width='24px'
            fill='currentColor'
            aria-hidden='true'
          >
            <path
              d='M120-240v-80h720v80H120Zm0-200v-80h720v80H120Zm0-200v-80h720v80H120Z'
            ></path>
          </svg>
        </button>
        <label class='toggle text-base-content toggle-sm'>
          <input
            id='theme-toggle'
            type='checkbox'
            class='theme-controller'
            aria-label='Dark mode'
          />
          <svg
            aria-label='sun'
            xmlns='http://www.w3.org/2000/svg'
            viewBox='0 0 24 24'
          >
            <g
              stroke-linejoin='round'
              stroke-linecap='round'
              stroke-width='2'
              fill='none'
              stroke='currentColor'
            >
              <circle cx='12' cy='12' r='4'></circle>
              <path d='M12 2v2'></path>
              <path d='M12 20v2'></path>
              <path d='m4.93 4.93 1.41 1.41'></path>
              <path d='m17.66 17.66 1.41 1.41'></path>
              <path d='M2 12h2'></path>
              <path d='M20 12h2'></path>
              <path d='m6.34 17.66-1.41 1.41'></path>
              <path d='m19.07 4.93-1.41 1.41'></path>
            </g>
          </svg>
          <svg
            aria-label='moon'
            xmlns='http://www.w3.org/2000/svg'
            viewBox='0 0 24 24'
          >
            <g
              stroke-linejoin='round'
              stroke-linecap='round'
              stroke-width='2'
              fill='none'
              stroke='currentColor'
            >
              <path d='M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z'></path>
            </g>
          </svg>
        </label>
      </div>
    </div>
  </div>
</div>

<script>
  const toggle = document.getElementById("theme-toggle") as HTMLInputElement;
  toggle.checked =
    document.documentElement.getAttribute("data-theme") === "dark";
  toggle.addEventListener("change", () => {
    const theme = toggle.checked ? "dark" : "light";
    document.documentElement.setAttribute("data-theme", theme);
    localStorage.setItem("theme", theme);
  });

  const menu = document.getElementById("mobile-menu")!;
  const menuButton = document.getElementById("hamburger-btn")!;
  const setMenuOpen = (open: boolean) => {
    menu.classList.toggle("hidden", !open);
    menu.classList.toggle("flex", open);
    menuButton.setAttribute("aria-expanded", String(open));
  };
  menuButton.addEventListener("click", () =>
    setMenuOpen(menu.classList.contains("hidden")),
  );
  menu.addEventListener("click", (e) => {
    if ((e.target as HTMLElement).closest("a")) setMenuOpen(false);
  });
</script>
