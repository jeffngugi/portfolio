---
import { experience } from "../data/data.js";
---

<div class='mt-10 scroll-mt-14' id='experience'>
  <h2 class="text-xl font-medium before:content-['>'] before:mr-1">
    Work Experience
  </h2>
  <div class='mt-6'>
    <ol
      class='relative space-y-8 before:absolute before:-ml-px before:h-full before:w-0.5 before:rounded-full before:bg-gray-200 dark:before:bg-gray-500 mt-4 p-2'
    >
      {
        experience.map((item) => (
          <li class='relative -ms-1.5 flex items-start gap-4'>
            <span class='size-3 shrink-0 rounded-full bg-base-content' />
            <div class='-mt-2'>
              <time class='text-xs font-medium text-base-content/80'>
                {item.date}
              </time>
              <h3 class='text-lg font-semibold text-base-content'>
                {item.title}
              </h3>
              <p class='mt-0.5 text-sm text-base-content/80'>
                {item.description}
              </p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</div>
