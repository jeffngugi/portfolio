---
import Layout from "../layouts/Layout.astro";
import { forms, seo } from "../data/data.js";
---

<Layout
  title={`Contact Me | ${seo.title}`}
  description='Get in touch with me to discuss projects, collaborations, or just to say hello.'
  keywords='contact, get in touch, collaboration, email, message, web developer'
>
  <div class='md:w-[700px] w-[100%] mt-5 p-4'>
    <main class='flex flex-col gap-2'>
      <h1 class="text-xl font-medium before:content-['>'] before:mr-1">
        Contact Me
      </h1>
      <div class='p-1'>
        <form
          id='contact-form'
          action={forms.formspreeUrl}
          method='POST'
          class='flex flex-col'
        >
          <div>
            <div>
              <label
                for='contact-name'
                class='uppercase text-sm text-base-content/80 font-bold'
                >Full Name</label
              >
              <input
                class='w-full mt-1 p-3 rounded-lg focus:outline-none border border-base-content text-base-content/80 focus:shadow-outline'
                type='text'
                id='contact-name'
                name='name'
                required
              />
            </div>
            <div class='mt-3'>
              <label
                for='contact-email'
                class='uppercase text-sm text-base-content/80 font-bold'
                >Email</label
              >
              <input
                class='w-full mt-1 p-3 rounded-lg focus:outline-none border border-base-content text-base-content/80 focus:shadow-outline'
                type='email'
                id='contact-email'
                name='email'
                required
              />
            </div>
            <div class='mt-3'>
              <label
                for='contact-message'
                class='uppercase text-sm text-base-content/80 font-bold'
                >Message</label
              >
              <textarea
                class='w-full mt-1 p-3 rounded-lg focus:outline-none border border-base-content text-base-content/80 focus:shadow-outline'
                id='contact-message'
                name='message'
                required></textarea>
            </div>
            <div class='mt-2'>
              <button
                type='submit'
                class='uppercase text-sm font-bold tracking-wide bg-base-content text-base-100 p-3 cursor-pointer hover:bg-base-content/95 rounded-lg w-full focus:outline-none focus:shadow-outline disabled:opacity-60 disabled:cursor-wait'
              >
                Send Message
              </button>
            </div>
          </div>
        </form>
      </div>
    </main>
  </div>

  <dialog id='contact-dialog' class='modal' aria-labelledby='contact-dialog-title'>
    <div class='modal-box'>
      <h2 id='contact-dialog-title' class='text-lg font-semibold'></h2>
      <p id='contact-dialog-body' class='mt-2 text-base-content/80'></p>
      <div class='modal-action'>
        <form method='dialog'>
          <button class='btn'>Close</button>
        </form>
      </div>
    </div>
    <form method='dialog' class='modal-backdrop'>
      <button>close</button>
    </form>
  </dialog>
</Layout>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement;
  const submitButton = form.querySelector("button[type=submit]")!;
  const dialog = document.getElementById("contact-dialog") as HTMLDialogElement;
  const dialogTitle = document.getElementById("contact-dialog-title")!;
  const dialogBody = document.getElementById("contact-dialog-body")!;

  const showDialog = (title: string, body: string) => {
    dialogTitle.textContent = title;
    dialogBody.textContent = body;
    dialog.showModal();
  };

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    const label = submitButton.textContent;
    submitButton.setAttribute("disabled", "");
    submitButton.textContent = "Sending…";
    try {
      // Formspree replies with JSON instead of its redirect page when asked.
      const res = await fetch(form.action, {
        method: "POST",
        body: new FormData(form),
        headers: { Accept: "application/json" },
      });
      if (!res.ok) throw new Error(`Formspree responded ${res.status}`);
      form.reset();
      showDialog(
        "Message sent",
        "Thanks for reaching out! I'll get back to you soon.",
      );
    } catch {
      showDialog(
        "Message not sent",
        "Something went wrong. Please try again, or email me directly.",
      );
    } finally {
      submitButton.removeAttribute("disabled");
      submitButton.textContent = label;
    }
  });
</script>
