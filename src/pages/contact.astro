---
import Layout from "../layouts/Layout.astro";
import { forms, seo } from "../data/data.js";
---

<Layout
  title={`Contact Me | ${seo.title}`}
  description='Get in touch with me to discuss projects, collaborations, or just to say hello.'
  keywords='contact, get in touch, collaboration, email, message, web developer'
>
  <div class='md:w-[700px] w-[100%] mt-5 p-4'>
    <main class='flex flex-col gap-2'>
      <h1 class="text-xl font-medium before:content-['>'] before:mr-1">
        Contact Me
      </h1>
      <div class='p-1'>
        <form action={forms.formspreeUrl} method='POST' class='flex flex-col'>
          <div>
            <div>
              <label
                for='contact-name'
                class='uppercase text-sm text-base-content/80 font-bold'
                >Full Name</label
              >
              <input
                class='w-full mt-1 p-3 rounded-lg focus:outline-none border border-base-content text-base-content/80 focus:shadow-outline'
                type='text'
                id='contact-name'
                name='name'
                required
              />
            </div>
            <div class='mt-3'>
              <label
                for='contact-email'
                class='uppercase text-sm text-base-content/80 font-bold'
                >Email</label
              >
              <input
                class='w-full mt-1 p-3 rounded-lg focus:outline-none border border-base-content text-base-content/80 focus:shadow-outline'
                type='email'
                id='contact-email'
                name='email'
                required
              />
            </div>
            <div class='mt-3'>
              <label
                for='contact-message'
                class='uppercase text-sm text-base-content/80 font-bold'
                >Message</label
              >
              <textarea
                class='w-full mt-1 p-3 rounded-lg focus:outline-none border border-base-content text-base-content/80 focus:shadow-outline'
                id='contact-message'
                name='message'
                required></textarea>
            </div>
            <div class='mt-2'>
              <button
                class='uppercase text-sm font-bold tracking-wide bg-base-content text-base-100 p-3 cursor-pointer hover:bg-base-content/95 rounded-lg w-full focus:outline-none focus:shadow-outline'
              >
                Send Message
              </button>
            </div>
          </div>
        </form>
      </div>
    </main>
  </div>
</Layout>
